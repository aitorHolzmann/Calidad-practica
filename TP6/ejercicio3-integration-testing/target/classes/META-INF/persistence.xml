<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!--
      Las propiedades de conexión (url, user, password) NO se fijan acá:
      Testcontainers asigna un puerto aleatorio en cada corrida, así que
      se inyectan en runtime desde el test vía
      Persistence.createEntityManagerFactory("testPU", overridesMap).
    -->
    <persistence-unit name="testPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>model.User</class>

        <properties>
            <!-- Solo para este ejercicio: en un proyecto real el schema
                 se versiona con Flyway/Liquibase, no con hbm2ddl.auto -->
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
